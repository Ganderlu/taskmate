rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {


    // Users can only create/read/update their OWN profile document
    match /users/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read, update: if request.auth != null && request.auth.uid == uid;
    }

    // ── TASKS ─────────────────────────────────────
    match /tasks/{taskId} {
      // Only the owner can create (must set their own userId)
      allow create: if request.auth != null &&
                     request.resource.data.userId == request.auth.uid;

      // Owner can read, update, delete their own tasks
      allow read, update, delete: if request.auth != null &&
                                  resource.data.userId == request.auth.uid;
    }

    // ── CATEGORIES ────────────────────────────────
    match /categories/{categoryId} {
      allow create: if request.auth != null &&
                     request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if request.auth != null &&
                                  resource.data.userId == request.auth.uid;
    }

    // ── PROJECTS ──────────────────────────────────
    match /projects/{projectId} {
      allow create: if request.auth != null &&
                     request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if request.auth != null &&
                                  resource.data.userId == request.auth.uid;
    }

    // ── TEAMS ─────────────────────────────────────
    match /teams/{teamId} {
      // Owner can create, update, delete
      allow create: if request.auth != null &&
                     request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if request.auth != null &&
                            resource.data.ownerId == request.auth.uid;

      // Anyone logged in can READ teams (name + description)
      // This is safe and necessary so pending invitees can see team name
      allow read: if request.auth != null;
    }

    // ── TEAM_MEMBERS ───────────────────────────────
    match /team_members/{memberId} {
      // ── READ ───────────────────────────────────────────────────────
      // Same permissive-read pattern as the parent /teams collection:
      // any logged-in user can READ team_members rows (query-scope friendly
      // and already the trust model used for /teams).
      allow read: if request.auth != null;

      // ── CREATE (send invite / add member) ──────────────────────────
      // Must be the team owner, verified via the ownerId field being written
      // onto the member row itself (so rules don't need cross-doc lookups).
      allow create: if request.auth != null &&
                    request.resource.data.ownerId == request.auth.uid;

      // ── UPDATE ─────────────────────────────────────────────────────
      // 1) Team owner can update any member of their team (role, permissions)
      allow update: if request.auth != null &&
                    resource.data.ownerId == request.auth.uid;

      // 2) Invited user can ACCEPT their own pending invite (set userId + status)
      allow update: if request.auth != null &&
                    (request.auth.token.email == resource.data.email ||
                     resource.data.userId == request.auth.uid) &&
                    resource.data.status == "pending" &&
                    request.resource.data.userId == request.auth.uid;

      // ── DELETE ─────────────────────────────────────────────────────
      // 1) Team owner can remove any member / cancel any invite
      allow delete: if request.auth != null &&
                    resource.data.ownerId == request.auth.uid;

      // 2) Invited user can DECLINE their own pending invite
      allow delete: if request.auth != null &&
                    (request.auth.token.email == resource.data.email ||
                     resource.data.userId == request.auth.uid) &&
                    resource.data.status == "pending";

      // 3) Existing accepted/active member can LEAVE the team (delete their own row)
      allow delete: if request.auth != null &&
                    resource.data.userId == request.auth.uid &&
                    (resource.data.status == "accepted" ||
                     resource.data.status == "active");
    }
  }
}
